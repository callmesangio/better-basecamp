{
  "manifest_version": 3,
  "name": "Better Basecamp",
  "version": "1.0.0",
  "description": "Removes the Basecamp layout wallpaper.",
  "content_scripts": [
    {
      "matches": ["https://*.basecamp.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "better-basecamp@example.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
